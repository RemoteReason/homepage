      <a
        href="https://calendly.com/remote-reason/30min"
        class="inline-flex items-center justify-center px-6 py-3 mb-4 bg-black text-white text-base font-semibold rounded-lg shadow transition"
      >
        Schedule call with Paul
      </a>
    </div>
    <!-- Paul Info (Bottom) -->
    <div class="flex flex-col items-center justify-center text-center pt-8">
      <img
        src="/images/paul.jpeg"
        alt="Paul Sabou"
        class="rounded-full shadow-lg w-40 h-40 object-cover border-4 border-indigo-200 mb-4"
      />
      <h2 class="text-2xl font-semibold text-gray-900 mb-1">Paul Sabou</h2>
      <p class="text-indigo-600 font-medium mb-2">Founder & CTO</p>
      <p class="text-gray-600 mb-4">
        20+ years experience as Software Engineer, CTO & Founder. I help startups and scaleups build AI native products, web & mobile apps, and cloud platforms.
      </p>
      <a
        href="https://www.linkedin.com/in/paul-sabou-8637b7b/"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition mb-2"
      >
        Connect on LinkedIn
        <svg class="ml-2 w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.28c-.966 0-1.75-.79-1.75-1.75s.784-1.75 1.75-1.75 1.75.79 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.28h-3v-5.6c0-1.34-.03-3.07-1.87-3.07-1.87 0-2.16 1.46-2.16 2.97v5.7h-3v-10h2.89v1.36h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.59v5.61z" />
