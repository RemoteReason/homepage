<div class="min-h-screen bg-white flex flex-col items-center justify-center">
  <div class="w-full max-w-2xl flex flex-col space-y-12 p-8">
    <!-- Company Info & Logo (Top) -->
    <div class="flex flex-col items-center justify-center text-center border-b border-gray-100 pb-8">
      <img src="/images/logo.svg" alt="RemoteReason Logo" class="w-80 h-40" />
      <p class="text-lg text-gray-600 mb-4">
        AI native product strategy, design, and engineering. We help you build and launch innovative software products, fast.
      </p>
      <div class="flex space-x-4 justify-center mt-4 mb-8">
        <a
          href="https://github.com/RemoteReason"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="text-gray-400 hover:text-gray-900"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.184 6.839 9.504.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.091-.647.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.987 1.029-2.686-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.295 2.748-1.025 2.748-1.025.546 1.378.202 2.397.1 2.65.64.699 1.028 1.593 1.028 2.686 0 3.847-2.337 4.695-4.566 4.944.359.309.678.919.678 1.852 0 1.336-.012 2.417-.012 2.747 0 .267.18.577.688.48C19.138 20.2 22 16.447 22 12.021 22 6.484 17.523 2 12 2z" />
          </svg>
        </a>
        <a
          href="https://twitter.com/RemoteReason"
          target="_blank"
          rel="noopener"
          aria-label="Twitter"
          class="text-gray-400 hover:text-gray-900"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.633 7.997c.013.176.013.353.013.53 0 5.386-4.099 11.6-11.6 11.6-2.307 0-4.453-.676-6.26-1.844.324.038.636.05.973.05 1.917 0 3.683-.636 5.093-1.708-1.793-.037-3.304-1.217-3.825-2.846.25.037.5.062.763.062.366 0 .73-.05 1.07-.142-1.87-.375-3.28-2.03-3.28-4.017v-.05c.548.304 1.18.487 1.85.512A4.07 4.07 0 0 1 2.8 6.575c0-.75.2-1.45.548-2.053C6.29 7.36 10.07 9.1 14.29 9.33c-.062-.3-.1-.6-.1-.91 0-2.21 1.793-4.004 4.004-4.004 1.15 0 2.19.487 2.92 1.27a7.93 7.93 0 0 0 2.548-.973 4.01 4.01 0 0 1-1.76 2.21 8.01 8.01 0 0 0 2.3-.624 8.6 8.6 0 0 1-2.01 2.09z" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/company/remote-reason"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="text-gray-400 hover:text-gray-900"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.28c-.966 0-1.75-.79-1.75-1.75s.784-1.75 1.75-1.75 1.75.79 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.28h-3v-5.6c0-1.34-.03-3.07-1.87-3.07-1.87 0-2.16 1.46-2.16 2.97v5.7h-3v-10h2.89v1.36h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.59v5.61z" />
