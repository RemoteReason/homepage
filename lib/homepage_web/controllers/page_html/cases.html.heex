<div class="bg-white py-14 sm:py-12">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <h2 class="text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl p-8">
        Our cases
      </h2>
    </div>
    <div class="group-item grid grid-cols-1 md:grid-cols-2 max-w-2xl gap-x-16 gap-y-16 lg:mx-0 lg:max-w-none">
      <!--Feature Container-->
      <%= for case <- Homepage.HomepageData.cases_list() do %>
        <.link href={case.case_page}>
          <div class="relative container flex flex-col max-w-6xl mx-auto mb-4 md:mb-10 px-6 text-gray-900 md:flex-row md:px-0">
            <div class="rounded-lg group item ">
              <!--Image-->
              <div class="md:h-44 overflow-hidden">
                <img
                  src={HomepageWeb.LinkHelper.image_path(case.image)}
                  alt=""
                  class="haspect-3/2 object-cover w-full duration-200 group-hover:scale-110"
                />
              </div>
              <!--Text Container-->
              <div class="flex flex-col md:flex-row md:justify-between shadow-lg rounded-b-lg p-2 md:p-10 bg-white">
                <div class="w-auto lg:w-1/2 max-w-lg font-sans tracking-tight text-2xl text-center text-gray-900 uppercase md:text-4xl">
                  {case.name}
                </div>
                <div class="w-auto lg:w-1/2 text-center md:text-right font-light text-sm md:text-xs tracking-tight md:pt-2">
                  {case.industry}
                </div>
              </div>
            </div>
          </div>
        </.link>
      <% end %>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-7xl lg:mx-0 mt-12 mb-12 pt-12">
      <h2 class="text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl text-center">
        People like working with us
      </h2>
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <.clutch_testimonials_widget />
    </div>
  </div>
</div>
<.lets_talk_cta />
