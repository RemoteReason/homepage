<.layout_page_centered>
  <!--Header -->
  <div class="mx-auto max-w-2xl pb-10 px-1 lg:mx-0">
    <h1 class="text-pretty text-4xl font-semibold tracking-tight text-gray-900
      sm:text-5xl">
      Case studies
    </h1>
    <p class="mt-6 text-lg text-gray-600">
      A selection of recent client engagements
    </p>
  </div>
  <div class="group-item grid grid-cols-1 md:grid-cols-2 max-w-2xl gap-x-16 gap-y-10 lg:mx-0 lg:max-w-none">
    <!--Feature Container-->
    <%= for case <- Homepage.HomepageData.cases_list() do %>
      <%= if case.case_page do %>
        <.link href={case.case_page} class="block">
          <div class="relative flex flex-col text-gray-900">
            <div class="rounded-lg overflow-hidden group item flex flex-col ring-1 ring-gray-300 shadow-lg">
              <!--Image-->
              <div class="h-40 overflow-hidden">
                <img
                  src={HomepageWeb.LinkHelper.image_path(case.image)}
                  alt=""
                  class="object-cover object-left-top w-full h-full duration-200 group-hover:scale-110"
                />
              </div>
              <!--Text Container-->
              <div class="flex flex-col md:flex-row md:justify-between shadow-lg p-3 md:p-6 bg-white">
                <div class="w-auto lg:w-1/2 font-sans tracking-tight text-2xl text-center md:text-left text-gray-900 uppercase md:text-4xl">
                  {case.name}
                </div>
                <div class="w-auto lg:w-1/2 text-center md:text-right font-light text-sm md:text-xs tracking-tight md:pt-2">
                  {case.industry}
                </div>
              </div>
            </div>
          </div>
        </.link>
      <% else %>
        <div class="block">
          <div class="relative flex flex-col text-gray-900">
            <div class="rounded-lg overflow-hidden group item flex flex-col ring-1 ring-gray-300 shadow-lg">
              <!--Image-->
              <div class="h-40 overflow-hidden">
                <img
                  src={HomepageWeb.LinkHelper.image_path(case.image)}
                  alt=""
                  class="object-cover object-left-top w-full h-full"
                />
              </div>
              <!--Text Container-->
              <div class="flex flex-col md:flex-row md:justify-between shadow-lg p-3 md:p-6 bg-white">
                <div class="w-auto lg:w-1/2 max-w-lg font-sans tracking-tight text-2xl text-center md:text-left text-gray-900 uppercase md:text-4xl">
                  {case.name}
                </div>
                <div class="w-auto lg:w-1/2 text-center md:text-right font-light text-sm md:text-xs tracking-tight md:pt-2">
                  {case.industry}
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</.layout_page_centered>
<div class="mx-auto max-w-7xl px-6 lg:px-8">
  <div class="mx-auto max-w-7xl lg:mx-0 mt-12 mb-12 pt-12">
    <h2 class="text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl text-center">
      People like working with us
    </h2>
  </div>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <.clutch_testimonials_widget />
  </div>
</div>
<div class="mt-16">
  <.lets_talk_cta />
</div>
