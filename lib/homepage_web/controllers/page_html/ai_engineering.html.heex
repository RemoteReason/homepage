<.layout_page_centered>
  <.content_page_header
    title="Deploy, integrate & fine tune AI"
    description="We deploy, integrate & fine tune commercial and open source AI models"
  />
  <.layout_bento_box rows={1}>
    <.layout_bento_box_small_container>
      <.content_list_items
        title="AI integration"
        description="We integrate your software with private AI deployments or AI service providers like OpenAI or Midjourney (and many others)."
        items={["AI API integration", "Integrate public & private data", "Prompt engineering"]}
      />
    </.layout_bento_box_small_container>

    <.layout_bento_box_small_container>
      <.content_list_items
        title="AI deployment"
        description="We deploy custom AI models alongside your software. You keep full control on your business data."
        items={[
          "Custom AI model deployments",
          "On premise & private clouds",
          "Performance tuning & cost control"
        ]}
      />
    </.layout_bento_box_small_container>

    <.layout_bento_box_small_container>
      <.content_list_items
        title="AI finetuning"
        description="We finetune custom or commerial AI models with your own business data. We make the AI system truly yours."
        items={[
          "Training on private documents",
          "Finetuning LLM's with human feedback",
          "Business case specific finetuning"
        ]}
      />
    </.layout_bento_box_small_container>
  </.layout_bento_box>

  <.details_features_card
    title="What do you get?"
    image={HomepageWeb.LinkHelper.image_path("/expertise/ai_engineering.svg")}
    description="Your AI system is crafted with care for your product strategy and is aligned with your organisational goals."
    features={[
      %{
        name: "Truly yours",
        icon_name: "hero-heart",
        description:
          "The AI system understands your own data & functions well for your specific business case."
      },
      %{
        name: "Testable",
        icon_name: "hero-list-bullet",
        description:
          "The AI system is automatically tested with adequate evals based on human & AI feedback."
      },
      %{
        name: "Compliant",
        icon_name: "hero-check-badge",
        description:
          "The AI system is compliant with your company policies, brand guidelines & data protection regulations."
      },
      %{
        name: "Performant",
        icon_name: "hero-bolt",
        description:
          "The AI service performs as expected. Infrastructure automatically grows to handle additional load."
      },
      %{
        name: "Secure",
        icon_name: "hero-shield-check",
        description:
          "The AI system & data is completely safe. Everything stays inside your company private infrastructure or within the boundaries of trusted suppliers."
      }
    ]}
  />
</.layout_page_centered>
