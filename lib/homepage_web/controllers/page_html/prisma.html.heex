<.layout_page_centered>
  <!-- Project header -->
  <.container_page_heading
    title="Prisma"
    description="Normaal leven. Dat is wat jij wilt."
  />
  <!-- Project Highlights  -->
  <.container_page_box>
    <.page_box_items title="The project">
      <p class="text-sm font-semibold">
        Sector: <span class="font-light">Health care industry </span>
      </p>
      <p class="text-sm font-semibold">Size: <span class="font-light">xxx </span></p>
      <p class="text-sm font-semibold">
        Budget: <span class="font-light">$50,000 to $199,999 </span>
      </p>
    </.page_box_items>
    <.page_box_items title="Highlights">
      <p class="text-sm font-light">- AI strategy</p>
      <p class="text-sm font-light">- Data migration</p>
      <p class="text-sm font-light">- Webshop integration</p>
    </.page_box_items>
    <.page_box_items title="Technologies">
      <p class="text-sm font-light">- AWS</p>
      <p class="text-sm font-light">- JAVA</p>
      <p class="text-sm font-light">- Elixir</p>
    </.page_box_items>
  </.container_page_box>
  <!-- Brand hero image -->
  <div class="container mx-auto px-6 md:pt-2 pb-5">
    <img src="/images/cases/prisma_home.png" alt="Product screenshot" />
  </div>
  <!-- About project -->
  <.container_page_text title="AI Solution Dev for Health Care Industry">
    <p>PrismaNet provides care for 3 000+ people with disabilities.
      Services include assisted living, day activities, and family support focusing
      on helping people live as independently as possible.</p>
  </.container_page_text>
  <!--Project objectives -->
  <.container_box_large
    alignment="right"
    image="/images/cases/prisma_about.png"
    title="Our work"
  >
